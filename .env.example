# Local development environment variables
# Copy this file to .env and fill in the values for your local setup.
# NEVER commit .env to git — it is already in .gitignore.
#
# On Streamlit Cloud, set these in Settings → Secrets (TOML format):
#   DATABASE_URL = "postgresql://..."

# Supabase / PostgreSQL Transaction pooler URL (IPv4, port 6543)
# When set, the app uses PostgreSQL. When absent, falls back to SQLite (roster_cafe.db).
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
